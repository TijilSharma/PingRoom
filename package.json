{
  "name": "pingroom",
  "version": "1.0.0",
  "description": "PingRoom MERN real-time chat and MongoDB review demonstration",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "vite",
    "build": "vite build",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:ui": "playwright test",
    "setup": "node scripts/setup.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.5"
  },
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "supertest": "^7.3.0",
    "vite": "^8.2.2"
  }
}
